{
  "name": "ui",
  "version": "0.0.0",
  "description": "frontend for dockman",
  "private": true,
  "author": "ra341",
  "main": "electron.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "desk:dev": "cross-env NODE_ENV=development electron .",
    "desk:build": "npx electron-builder --dir"
  },
  "build": {
    "appId": "dev.radn.dockman",
    "files": [
      "electron.cjs"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "public/dockman.png"
    },
    "linux": {
      "icon": "public/dockman.png"
    }
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.10.1",
    "@connectrpc/connect": "^2.0.2",
    "@connectrpc/connect-web": "^2.1.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.2.9",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@nivo/line": "^0.99.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "composerize": "^1.7.5",
    "immer": "^11.1.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "reconnecting-websocket": "^4.4.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.3"
  },
  "overrides": {
    "dompurify": "3.4.13",
    "@electron/asar": "4.2.1",
    "@electron/universal": "3.0.6",
    "dir-compare": "5.0.0",
    "ejs": "6.0.1",
    "jake": "12.10.1",
    "filelist": "2.0.2",
    "glob": "13.0.2",
    "minimatch": "10.2.5",
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "postcss": "8.5.23",
    "undici": "7.29.0",
    "rimraf": "6.1.3",
    "electron-winstaller": "5.4.4"
  }
}
